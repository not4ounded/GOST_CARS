<Window x:Class="GOST_CARS_FRONT.EditCarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GOST_CARS_FRONT"
        mc:Ignorable="d"
        Title="Редактирование автомобиля" Height="400" Width="400" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="Марка:" Margin="0,0,5,0"/>
        <TextBox x:Name="BrandTB" Height="30" FontSize="16"/>

        <TextBlock Text="Модель:" Margin="0,10,5,0"/>
        <TextBox x:Name="ModelTB" Height="30" FontSize="16"/>

        <TextBlock Text="Год выпуска:" Margin="0,10,5,0"/>
        <TextBox x:Name="YearTB" Height="30" FontSize="16" TextChanged="TextBox_TextChanged"/>

        <TextBlock Text="Цена:" Margin="0,10,5,0"/>
        <TextBox x:Name="PriceTB" Height="30" FontSize="16" TextChanged="TextBox_TextChanged"/>

        <UniformGrid Columns="2" Margin="0,20,0,0">
            <Button x:Name="SaveBtn" Content="Сохранить" Height="35" Margin="5" Click="SaveBtn_Click"/>
            <Button x:Name="CancelBtn" Content="Отмена" Height="35" Margin="5" Click="CancelBtn_Click"/>
        </UniformGrid>
    </StackPanel>
    
</Window>
