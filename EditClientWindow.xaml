<Window x:Class="GOST_CARS_FRONT.EditClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GOST_CARS_FRONT"
        mc:Ignorable="d"
        Title="Редактирование клиента" Height="450" Width="800">
    
    <StackPanel Margin="20">
        <TextBlock Text="ФИО:" Margin="0,0,5,0"/>
        <TextBox x:Name="FCsTB" Height="30" FontSize="16"/>

        <TextBlock Text="Номер телефона:" Margin="0,10,5,0"/>
        <TextBox x:Name="PhoneNumTB" Height="30" FontSize="16"/>

        <TextBlock Text="Адрес:" Margin="0,10,5,0"/>
        <TextBox x:Name="AddressTB" Height="30" FontSize="16"/>

        <TextBlock Text="Дата приобретения:" Margin="0,10,5,0"/>
        <TextBox x:Name="PurchaseDateTB" Height="30" FontSize="16"/>

        <UniformGrid Columns="2" Margin="0,20,0,0">
            <Button x:Name="SaveBtn" Content="Сохранить" Height="35" Margin="5" Click="SaveBtn_Click"/>
            <Button x:Name="CancelBtn" Content="Отмена" Height="35" Margin="5" Click="cancelBtn_Click"/>
        </UniformGrid>
    </StackPanel>
</Window>
