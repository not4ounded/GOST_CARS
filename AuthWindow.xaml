<Window x:Class="GOST_CARS_FRONT.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GOST_CARS_FRONT"
        mc:Ignorable="d"
        Title="AuthWindow" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Авторизация" FontSize="36" Margin="10" HorizontalAlignment="Center" FontFamily="Arial"/>
            <TextBlock Text="Логин" FontSize="20" Margin="10, 20, 0, 0" FontFamily="Arial"/>
            <TextBox x:Name="loginTB" Margin="10, 5, 10, 0" Height="50" FontFamily="Arial" FontSize="20"/>
            <TextBlock Text="Пароль" FontSize="20" Margin="10, 20, 0, 0" FontFamily="Arial"/>
            <PasswordBox x:Name="passBox" Margin="10, 5, 10, 0" Height="50" FontFamily="Arial" FontSize="20"/>
        </StackPanel>
        <Button DockPanel.Dock="Bottom" x:Name="loginBtn" Content="Войти" HorizontalAlignment="Center" Height="50" Width="400" FontSize="24"/>
    </DockPanel>
</Window>
